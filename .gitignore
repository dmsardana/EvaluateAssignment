__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# OS
.DS_Store
Thumbs.db

# Editor
.idea/
.vscode/
.claude/
*.swp
*~

# LaTeX intermediate output (just in case)
*.aux
*.log
*.out
*.toc
*.fls
*.fdb_latexmk
