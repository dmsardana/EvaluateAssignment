% ============================================================
%  ts_evalreport.sty
%  ThinkingSouls Education - Assignment Evaluation Report Style
% ------------------------------------------------------------
%  Designed for: xelatex (recommended) or lualatex
%  Author      : Mohit Sardana / ThinkingSouls
%  Version     : 1.0 (May 2026)
% ------------------------------------------------------------
%  Provides:
%    Document structure  : \tsHeader, \tsFooter
%    Title block         : \tsStudentBlock{name}{assignment}{topic}{date}
%    Headline score      : \tsScoreBlock{percent}{marks}{N}{band}{verdict}
%    Promotion bar       : \tsPromotionBar{color}{label}{text}
%    Rubric table        : \tsRubricTable
%    Sections            : \tsSection{title}, \tsSubSection{title}
%    Hanging bullets     : tspoints environment
%    Per-question card   : tsQCard environment + \tsDimBox helpers
%    Scan note           : \tsScanNote{text}
%    Scanning tips       : tsScanTips environment, \tsTip{n}{title}{body}
%    Disclaimer          : \tsDisclaimer
% ============================================================

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{ts_evalreport}[2026/05/09 v1.1 ThinkingSouls Evaluation Report Style]

% ===== Required packages =====
\RequirePackage{geometry}
\RequirePackage{xcolor}
\RequirePackage{fontspec}        % xelatex/lualatex
\RequirePackage{unicode-math}
\RequirePackage{fancyhdr}
\RequirePackage{tcolorbox}
\tcbuselibrary{skins,breakable}
\RequirePackage{enumitem}
\RequirePackage{multicol}        % two-column Scanning Tips list
\RequirePackage{adjustbox}       % max width=\linewidth — scale-down for overlong math
\RequirePackage{xfp}             % \fpeval — used by \tsDimBoxAuto to show weight × score
\RequirePackage{siunitx}         % \num{...} — fixed-decimal formatting for weighted scores
\sisetup{
    round-mode=places,
    round-precision=2,
    zero-decimal-to-integer=false,
    output-decimal-marker={.},
    detect-all,
}
\RequirePackage{array}
\RequirePackage{tabularx}
\RequirePackage{longtable}
\RequirePackage{colortbl}
\RequirePackage{graphicx}
\RequirePackage{tikz}
\usetikzlibrary{fadings}
% Fade-out fading: when applied to a white-filled shape, makes the LEFT portion
% transparent (text visible) and the RIGHT portion opaque white (text hidden).
% The fade starts kicking in around 40% width so the question opening is fully
% visible and the tail fades to white at ~70% width.
\tikzfading[
    name=tsQFade,
    left color=transparent!100,
    right color=transparent!0
]
\RequirePackage[hidelinks]{hyperref}
\RequirePackage{ragged2e}
\RequirePackage{microtype}
\RequirePackage{needspace}
\RequirePackage{qrcode}

