% \tsImprove{rank}{labelText}{labelColor}{title}{action}{successCriterion}{byWhen}
% BOLD EDITORIAL DESIGN: oversized priority numeral as graphic element + color-flooded
% left block + tracked uppercase labels. Visual hierarchy reinforces priority ranking.
% Implementation: use a single tcolorbox with overlay + minipages positioned absolutely
\newcommand{\tsImprove}[7]{%
    \item \par\noindent
    % Outer container box - holds both left color block and right content side by side
    \begin{tcolorbox}[
        enhanced,
        colback=white, colframe=white, boxrule=0pt, arc=0pt,
        left=0pt, right=0pt, top=0pt, bottom=0pt,
        before skip=0pt, after skip=0pt,
        nobeforeafter,
        height=3.6cm,
        overlay={%
            % LEFT BLOCK: color-flooded with massive priority numeral
            \begin{scope}[shift={(frame.north west)}]
                \fill[#3] (0, 0) rectangle (4.5cm, -3.4cm);
                \node[anchor=north west, text=white,
                      font=\fontsize{7pt}{8pt}\bfseries\selectfont]
                      at (0.30cm, -0.35cm) {P\,R\,I\,O\,R\,I\,T\,Y};
                \node[anchor=north west, text=white,
                      font=\fontsize{42pt}{42pt}\bfseries\selectfont]
                      at (0.25cm, -0.7cm) {0#1};
                \node[anchor=north west, text=white,
                      font=\fontsize{10pt}{12pt}\selectfont]
                      at (0.30cm, -2.7cm) {#2};
            \end{scope}
        }
    ]
        % CONTENT: right block, positioned by leaving left whitespace via \hspace
        \noindent\hspace{5.0cm}%
        \begin{minipage}[t]{12.0cm}
            \par\vspace{0pt}%
            % Title
            {\fontsize{13pt}{16pt}\selectfont\color{tsText}\textbf{#4}}\par\vspace{8pt}%
            % --- ACTION ROW ---
            \noindent\begin{minipage}[t]{1.8cm}\par\vspace{1pt}%
                {\fontsize{6.5pt}{8pt}\selectfont\color{#3}\textbf{A C T I O N}}%
            \end{minipage}\begin{minipage}[t]{10.0cm}%
                {\fontsize{9pt}{12pt}\selectfont\color{tsText} #5}%
            \end{minipage}\par\vspace{6pt}%
            % --- MEASURE ROW ---
            \noindent\begin{minipage}[t]{1.8cm}\par\vspace{1pt}%
                {\fontsize{6.5pt}{8pt}\selectfont\color{#3}\textbf{M E A S U R E}}%
            \end{minipage}\begin{minipage}[t]{10.0cm}%
                {\fontsize{9pt}{12pt}\selectfont\color{tsText} #6}%
            \end{minipage}\par\vspace{6pt}%
            % --- BY WHEN ROW ---
            \noindent\begin{minipage}[t]{1.8cm}\par\vspace{1pt}%
                {\fontsize{6.5pt}{8pt}\selectfont\color{#3}\textbf{B Y\ \ W H E N}}%
            \end{minipage}\begin{minipage}[t]{10.0cm}%
                {\fontsize{9pt}{12pt}\selectfont\color{tsText} #7}%
            \end{minipage}%
        \end{minipage}%
    \end{tcolorbox}
    \par\vspace{6pt}%
    \noindent\textcolor{tsLightGrey}{\rule{17cm}{0.4pt}}%
    \par
}

% ===== Concept Dependency Heat-Map =====
% Visual map of which concepts each question tests, colored by performance.
% Rows = concepts, Cols = questions (e.g. 25). Each cell colored by per-question score.
%
% Cell color shortcuts (use these directly inside the row macro):
%   \tsCG  -> green cell (full mark on this concept)
%   \tsCA  -> amber cell (partial)
%   \tsCR  -> red cell (failed)
%   \tsCN  -> neutral grey cell (untested by this question)
%
% Usage:
%   \begin{tsConceptMap}{25}
%       \tsConceptMapHeader{25}
%       \tsConceptRow{Square root non-negativity}{\tsCG \tsCN \tsCG \tsCG ...}
%       \tsConceptRow{Log argument positivity}{...}
%   \end{tsConceptMap}

% Cell content macros - colored cells. Use & as the explicit separator between cells.
% Example row content: \tsCG &\tsCN &\tsCG &\tsCA &\tsCR
\newcommand{\tsCG}{\cellcolor{tsGreen}\rule{0pt}{6pt}}    % green = full mark
\newcommand{\tsCA}{\cellcolor{tsAmber}\rule{0pt}{6pt}}    % amber = partial
\newcommand{\tsCR}{\cellcolor{tsRed}\rule{0pt}{6pt}}      % red = failed
\newcommand{\tsCN}{\cellcolor{tsLightGrey}\rule{0pt}{6pt}} % neutral grey = untested

% Header cell helper - wraps a Q-number with consistent small grey styling
% so that all column headers (1, 2, ... 25) have the same alignment and font.
\newcommand{\tsCH}[1]{{\fontsize{6pt}{7pt}\selectfont\color{tsGrey}#1}}

% Concept map environment - sets up a fixed-width tabular
% #1 = number of questions (e.g. 25)
% Concept column 5cm, each Q cell 0.42cm wide -> 5 + 25*0.42 = ~15.5cm fits in 17cm
\newenvironment{tsConceptMap}[1]{%
    \par\vspace{0.2cm}\noindent
    \begingroup
    \setlength{\tabcolsep}{1.5pt}%
    \renewcommand{\arraystretch}{1.0}%
    \arrayrulecolor{white}%
    \fontsize{7pt}{8pt}\selectfont\color{tsText}%
    \noindent
    \begin{tabular}{@{}p{5.0cm}@{\hspace{2pt}}*{#1}{>{\centering\arraybackslash}p{0.42cm}@{}}}
}{%
    \end{tabular}
    \endgroup
    \par
}

% Header row - the user passes the cell content with explicit & separators
% (e.g. "1 &2 &3 &... &25"). Setting fontsize globally for the row via the
% \tabular column spec ensures each cell renders consistently.
% We need to NOT wrap the entire row content in {} because that hides the &
% column separators. Instead, we use \multicolumn to set font per cell.
%
% Simplest reliable approach: set the font in the surrounding tabular's column
% spec via >{...} prefix, and let the user's cells flow naturally.
\newcommand{\tsConceptMapHeader}[1]{%
    {\fontsize{6pt}{7pt}\selectfont\color{tsGrey}\textit{Concept}}
    & #1 \tabularnewline[3pt]
}

% Concept row
% #1 = concept name (left column)
% #2 = sequence of \tsCG/\tsCA/\tsCR/\tsCN, separated by &
\newcommand{\tsConceptRow}[2]{%
    {\fontsize{7.5pt}{9pt}\selectfont\color{tsText}\textbf{#1}}
    & #2 \tabularnewline[2pt]
}

