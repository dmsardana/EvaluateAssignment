% ===== Title (student) block =====
% \tsStudentBlock{Name}{Assignment}{Topic}{Date}
% Column widths: 4.0 + 5.5 + 4.5 + 3.0 = 17cm exactly (no inter-col padding via @{})
\newcommand{\tsStudentBlock}[4]{%
    \par\vspace{0.2cm}
    \noindent
    \begin{tabular}{@{}p{4.0cm}@{}p{5.5cm}@{}p{4.5cm}@{}p{3.0cm}@{}}
        {\fontsize{8pt}{10pt}\selectfont\color{tsGrey} STUDENT} &
        {\fontsize{8pt}{10pt}\selectfont\color{tsGrey} ASSIGNMENT} &
        {\fontsize{8pt}{10pt}\selectfont\color{tsGrey} TOPIC} &
        {\fontsize{8pt}{10pt}\selectfont\color{tsGrey} EVALUATION DATE} \\[2pt]
        {\fontsize{13pt}{15pt}\selectfont\color{tsText}\textbf{#1}} &
        {\fontsize{11pt}{13pt}\selectfont\color{tsText}\textbf{#2}} &
        {\fontsize{10.5pt}{12.5pt}\selectfont\color{tsText}\textbf{#3}} &
        {\fontsize{11pt}{13pt}\selectfont\color{tsText}\textbf{#4}} \\
    \end{tabular}
    \par\vspace{2pt}
    {\color{tsLightGrey}\rule{\textwidth}{0.6pt}}
    \par\vspace{0.5cm}
}

% ===== Headline score block =====
% \tsScoreBlock{percent}{marks}{maxmarks}{band}{bandColor}{verdict}
\newcommand{\tsScoreBlock}[6]{%
    \par\noindent
    \begin{minipage}[c]{0.43\textwidth}
        \centering
        {\fontsize{42pt}{46pt}\selectfont\color{tsRed}\textbf{#1}\par}
        \vspace{4pt}
        {\fontsize{10pt}{12pt}\selectfont\color{tsGrey} #2 / #3 marks}
    \end{minipage}%
    \hfill%
    \begin{minipage}[c]{0.55\textwidth}
        \begin{tcolorbox}[
            colback=#5, colframe=#5, boxrule=0pt, arc=2pt,
            left=12pt, right=12pt, top=14pt, bottom=14pt,
            halign=center, valign=center,
            before skip=0pt, after skip=0pt
        ]
            {\fontsize{18pt}{22pt}\selectfont\color{white}\textbf{#4}}\\[4pt]
            {\fontsize{9pt}{12pt}\selectfont\color{white} #6}
        \end{tcolorbox}
    \end{minipage}
    \par\vspace{0.4cm}
}

