% Helper: a single dimension box
% #1: full dimension name, #2: percentage (e.g. "100%"), #3: weighted contribution (e.g. "0.40")
% #4: background color
\newcommand{\tsDimBox}[4]{%
    \begin{tcolorbox}[
        colback=#4, colframe=#4, boxrule=0pt, arc=0pt,
        left=2pt, right=2pt, top=4pt, bottom=4pt,
        halign=center, valign=center,
        height=1.7cm, width=3.2cm
    ]
        {\fontsize{7pt}{8pt}\selectfont\color{white}#1}\\[2pt]
        {\fontsize{14pt}{16pt}\selectfont\color{white}\textbf{#2}}\\[1pt]
        {\fontsize{7.5pt}{9pt}\selectfont\color{white} weight $\times$ score = #3}
    \end{tcolorbox}%
}

% Determine box color from percentage
% #1: percentage as a plain number (0-100)
% #2: command name to define with the result color
\newcommand{\tsDimColor}[1]{%
    \ifnum#1<50 tsRed\else\ifnum#1<100 tsAmber\else tsGreen\fi\fi%
}

% Question card environment
% Args: {qno}{topic}{scanQuality}{scanColor}{totalScore}{scoreOutOf}
% Cards are NOT breakable - if a card won't fit on current page, push to next page.
% The \needspace check ensures that if less than ~6.5cm remains on current page,
% we break before starting the card (avoiding orphaned headers).
\newenvironment{tsQCard}[6]{%
    \par\needspace{6.5cm}%
    \par\vspace{0.4cm}\noindent
    \begin{tcolorbox}[
        enhanced,
        colback=white, colframe=tsBorder,
        boxrule=0.6pt, arc=2pt,
        leftrule=3pt, frame style={tsBorder},
        borderline west={3pt}{0pt}{tsRed},
        left=12pt, right=12pt, top=10pt, bottom=10pt,
        before skip=0pt, after skip=0pt
    ]%
    % Header row: Q# + function on left, score on right
    \noindent
    \begin{minipage}[t]{0.78\linewidth}\raggedright%
        % Render Q# inline with the function. Overlong inline-math expressions
        % (e.g. Q15-style four-sub-question lists) cannot word-wrap in LaTeX,
        % so we use adjustbox `max width' to scale them down to the minipage
        % width — small expressions render at natural size, oversized ones
        % shrink instead of bleeding into the right-side score block.
        {\fontsize{11pt}{13pt}\selectfont\color{tsRed}\textbf{Q#1.}\ \ }%
        \adjustbox{max width=0.93\linewidth, valign=B}{%
            {\fontsize{11pt}{13pt}\selectfont\color{tsText}\tsQFuncContent}%
        }%
    \end{minipage}\hfill%
    \begin{minipage}[t]{0.20\linewidth}\raggedleft%
        {\fontsize{14pt}{16pt}\selectfont\color{tsRed}\textbf{#5}\fontsize{8pt}{10pt}\selectfont\color{tsGrey}\ /\ #6}%
    \end{minipage}\par\vspace{2pt}
    % Topic + Scan quality
    \noindent
    \begin{minipage}[t]{0.55\linewidth}\raggedright%
        {\fontsize{8.5pt}{11pt}\selectfont\color{tsGrey}\textit{Topic: #2}}%
    \end{minipage}\hfill%
    \begin{minipage}[t]{0.42\linewidth}\raggedleft%
        {\fontsize{8.5pt}{11pt}\selectfont\color{tsGrey}\textit{Scan Quality:}\ \color{#4}\textbf{#3}}%
    \end{minipage}\par\vspace{6pt}
    % Answer comparison - label row and text row use same column split
    % so YOUR ANSWER aligns above your-answer text, EXPECTED above expected-answer text.
    \noindent
    \begin{tcolorbox}[
        colback=tsBgLight, colframe=tsBgLight, boxrule=0pt, arc=0pt,
        left=6pt, right=6pt, top=3pt, bottom=3pt,
        before skip=0pt, after skip=0pt
    ]
        {\fontsize{8pt}{10pt}\selectfont\color{tsGrey}%
        \begin{minipage}[t]{0.49\linewidth}\raggedright YOUR ANSWER\end{minipage}%
        \hfill%
        \begin{minipage}[t]{0.49\linewidth}\raggedright EXPECTED\end{minipage}%
        }
    \end{tcolorbox}%
    \begin{tcolorbox}[
        colback=white, colframe=tsBorder, boxrule=0.4pt, arc=0pt, top=3pt, bottom=3pt,
        left=6pt, right=6pt, before skip=-0.6pt, after skip=0pt
    ]
        {\fontsize{9pt}{11pt}\selectfont
        \begin{minipage}[t]{0.49\linewidth}\raggedright\color{tsText}\tsQAnswerYour\end{minipage}%
        \hfill%
        \begin{minipage}[t]{0.49\linewidth}\raggedright\color{tsGreen}\tsQAnswerIdeal\end{minipage}%
        }
    \end{tcolorbox}\par\vspace{6pt}
    % Dimension boxes - 5 across, spanning full content width (5 x 3.4cm = 17cm)
    \tsRenderDimRow
    \par\vspace{8pt}
    % Feedback - hanging indent: "Feedback:" label at left margin (0),
    % body starts at 2cm, wrapped lines align at 2cm
    \begin{list}{}{%
        \setlength{\leftmargin}{2cm}%
        \setlength{\itemindent}{-2cm}%
        \setlength{\labelwidth}{0pt}%
        \setlength{\labelsep}{0pt}%
        \setlength{\listparindent}{0pt}%
        \setlength{\topsep}{0pt}%
        \setlength{\parsep}{0pt}%
        \setlength{\itemsep}{4pt}%
        \setlength{\rightmargin}{0pt}%
    }
    \item {\fontsize{9pt}{12.5pt}\selectfont\color{tsText}%
        \makebox[2cm][l]{\textbf{Feedback:}}\tsQFeedbackText}
    \iftsHasScanNote
    \item {\fontsize{8.5pt}{11.5pt}\selectfont\color{tsAmber}%
        \makebox[2cm][l]{\textbf{Scan note:}}\tsQScanNoteText}
    \fi
    \end{list}
}{%
    \end{tcolorbox}%
    % Reset state for next card (global so it survives the env group)
    \gdef\tsQScanNoteText{}%
    \global\tsHasScanNotefalse%
    \par
}

% Dimension row renderer - decides color from numerical percentages
% Note: tsQDimCU/AM/SS/NA/PR are stored as integer percentages (0..100)
% 5 tiles x 3.2cm = 16cm; centered within 17cm content width (0.5cm each side)
% For two-line labels: \tsTwoLine{Word1}{Word2} renders with 2pt gap between lines.
% All tiles use fixed-height rows so the percentage and "Weighted Score" lines
% sit at the same vertical position across all 5 tiles in a row.
\newcommand{\tsTwoLine}[2]{%
    \begin{tabular}{@{}c@{}}#1\\[2pt] #2\end{tabular}%
}
\newcommand{\tsRenderDimRow}{%
    \par\noindent\hspace*{-12pt}% pull left to align with card border (cancel card's internal left padding)
    \makebox[17cm][c]{%
        \tsDimBoxAuto{\tsTwoLine{Conceptual}{Understanding}}{\tsQDimCU}{0.40}%
        \tsDimBoxAuto{\tsTwoLine{Approach}{\&\ Method}}{\tsQDimAM}{0.20}%
        \tsDimBoxAuto{\tsTwoLine{Step-by-Step}{Execution}}{\tsQDimSS}{0.20}%
        \tsDimBoxAuto{\tsTwoLine{Numerical}{Accuracy}}{\tsQDimNA}{0.10}%
        \tsDimBoxAuto{\tsTwoLine{Presentation}{\&\ Clarity}}{\tsQDimPR}{0.10}%
    }%
    \par
}

% Dimension box that auto-picks color from percentage.
% Uses three fixed-height stacked rows so values align across tiles in a row.
% #1: name (use \tsTwoLine{}{} for two-line labels), #2: percentage int (0..100), #3: weight
\newcommand{\tsDimBoxAuto}[3]{%
    \edef\tsTmpPct{#2}%
    \ifnum\tsTmpPct<50%
        \def\tsTmpColor{tsRed}%
    \else\ifnum\tsTmpPct<100%
        \def\tsTmpColor{tsAmber}%
    \else%
        \def\tsTmpColor{tsGreen}%
    \fi\fi%
    \begin{tcolorbox}[
        colback=\tsTmpColor, colframe=white, boxrule=0.6pt, arc=0pt,
        left=2pt, right=2pt, top=3pt, bottom=3pt,
        halign=center, valign=top,
        before skip=0pt, after skip=0pt,
        width=3.2cm, height=2.2cm,
        nobeforeafter
    ]
        % Row 1: Label area (fixed height 22pt) - fits 1 or 2 lines at 7.5pt with 2pt gap
        \begin{minipage}[t][22pt][t]{\linewidth}\centering%
        {\fontsize{7.5pt}{9pt}\selectfont\color{white} #1}%
        \end{minipage}\\[0pt]
        % Row 2: Percentage (fixed height - top-aligned for consistent baseline)
        \begin{minipage}[t][20pt][t]{\linewidth}\centering%
        {\fontsize{16pt}{18pt}\selectfont\color{white}\textbf{#2\%}}%
        \end{minipage}\\[0pt]
        % Row 3: Weight + Score split (May-14 reference format).
        % #3 is the static weight (0.40, 0.20, …) and #2 is the dimension
        % percentage. The weighted contribution = #3 × #2/100, formatted
        % to two fixed decimals via siunitx \num so 0.4 renders as 0.40.
        \begin{minipage}[t][10pt][t]{\linewidth}\centering%
        {\fontsize{6.5pt}{8pt}\selectfont\color{white} Weight = \num{#3}\ \ Score = \num{\fpeval{round(#3*#2/100, 2)}}}%
        \end{minipage}%
    \end{tcolorbox}%
}

