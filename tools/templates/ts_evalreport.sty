% ===== Snowflake (5-axis radar) chart =====
% Inspired by Simply Wall Street's Portfolio Snowflake.
% Plots 5 dimensions on a regular pentagon: CU (top), AM (top-right), SS (bottom-right),
% NA (bottom-left), PR (top-left). Each axis is 0..100; score plotted as distance from center.
% Usage: \tsSnowflake{cuPct}{amPct}{ssPct}{naPct}{prPct}
% The five percentages should be integers 0..100.
\newcommand{\tsSnowflake}[5]{%
    \begin{tikzpicture}[scale=1.0]
        % Pentagon vertices at 90, 162, 234, 306, 18 degrees (top, top-left, bottom-left, bottom-right, top-right)
        % Mapping: vertex 1 (top) = CU, 2 (top-right, 18deg) = AM, 3 (bottom-right) = SS,
        %          4 (bottom-left) = NA, 5 (top-left) = PR
        % Radius scale: 100% = 1.7cm (compact for side-by-side, leaving room for labels)
        \def\radius{1.7cm}
        % Background SMOOTH grid rings at 25%, 50%, 75%, 100% (instead of pentagons -
        % gives the chart its organic snowflake look like Simply Wall Street)
        \foreach \pct in {25, 50, 75, 100} {
            \draw[tsLightGrey, line width=0.4pt]
                plot[smooth cycle, tension=0.7] coordinates {
                    (90:\pct/100*\radius)
                    (18:\pct/100*\radius)
                    (306:\pct/100*\radius)
                    (234:\pct/100*\radius)
                    (162:\pct/100*\radius)
                };
        }
        % Axis lines from center
        \foreach \angle in {90, 162, 234, 306, 18} {
            \draw[tsLightGrey, line width=0.4pt] (0,0) -- (\angle:\radius);
        }
        % Outer ring percentage labels (positioned near top-right axis where there's space)
        \node[tsGrey, font=\fontsize{5.5pt}{6.5pt}\selectfont] at (54:\radius+0.18cm) {100\%};
        \node[tsGrey, font=\fontsize{5.5pt}{6.5pt}\selectfont] at (54:0.425cm) {25\%};
        \node[tsGrey, font=\fontsize{5.5pt}{6.5pt}\selectfont] at (54:0.85cm) {50\%};
        \node[tsGrey, font=\fontsize{5.5pt}{6.5pt}\selectfont] at (54:1.275cm) {75\%};
        % Score blob - smooth curve through 5 score points (the snowflake shape)
        \fill[tsRed, fill opacity=0.25]
            plot[smooth cycle, tension=0.8] coordinates {
                (90:#1/100*\radius)
                (18:#2/100*\radius)
                (306:#3/100*\radius)
                (234:#4/100*\radius)
                (162:#5/100*\radius)
            };
        \draw[tsRed, line width=1.4pt]
            plot[smooth cycle, tension=0.8] coordinates {
                (90:#1/100*\radius)
                (18:#2/100*\radius)
                (306:#3/100*\radius)
                (234:#4/100*\radius)
                (162:#5/100*\radius)
            };
        % Score points
        \foreach \angle/\score in {90/#1, 18/#2, 306/#3, 234/#4, 162/#5} {
            \fill[tsRed] (\angle:\score/100*\radius) circle (1.8pt);
        }
        % Axis labels (outside the snowflake)
        \node[tsText, font=\fontsize{7pt}{8.5pt}\selectfont\bfseries, align=center] at (90:\radius+0.55cm) {Conceptual\\Understanding};
        \node[tsText, font=\fontsize{7pt}{8.5pt}\selectfont\bfseries, align=center] at (18:\radius+0.65cm) {Approach\\\&\ Method};
        \node[tsText, font=\fontsize{7pt}{8.5pt}\selectfont\bfseries, align=center] at (306:\radius+0.65cm) {Step-by-Step\\Execution};
        \node[tsText, font=\fontsize{7pt}{8.5pt}\selectfont\bfseries, align=center] at (234:\radius+0.65cm) {Numerical\\Accuracy};
        \node[tsText, font=\fontsize{7pt}{8.5pt}\selectfont\bfseries, align=center] at (162:\radius+0.65cm) {Presentation\\\&\ Clarity};
    \end{tikzpicture}%
}


% ===== Rubric table =====
% \tsRubricTable{rows} - rows is a list of \rubricRow lines
% Vertical alignment: all cells centered using m{} columns + arraystretch
\newcommand{\rubricRow}[4]{%
    #1 & #2 & \textbf{#3} & #4 \\
    \hline
}
% Standard rubric table - full content width (17cm)
\newenvironment{tsRubricTable}{%
    \par\noindent
    \renewcommand{\arraystretch}{1.5}%
    \arrayrulecolor{tsLightGrey}%
    \begin{tabular}{|m{7.0cm}|>{\centering\arraybackslash}m{2.3cm}|>{\centering\arraybackslash}m{2.3cm}|m{4.2cm}|}
        \hline
        \rowcolor{tsRed}
        \cellcolor{tsRed}{\color{white}\textbf{Dimension}} &
        \cellcolor{tsRed}{\centering\color{white}\textbf{Weight}} &
        \cellcolor{tsRed}{\centering\color{white}\textbf{Score}} &
        \cellcolor{tsRed}{\color{white}\textbf{Status}} \\
        \hline
}{%
    \end{tabular}
    \par
}

% Compact rubric table for side-by-side layout
% Columns: 4.0 + 1.1 + 1.4 + 2.0 = 8.5cm of content (plus borders/padding ~0.5cm = 9cm total)
\newenvironment{tsRubricTableCompact}{%
    \par\noindent
    \renewcommand{\arraystretch}{1.5}%
    \arrayrulecolor{tsLightGrey}%
    \setlength{\tabcolsep}{4pt}%
    \begin{tabular}{|m{4.0cm}|>{\centering\arraybackslash}m{1.1cm}|>{\centering\arraybackslash}m{1.4cm}|m{2.0cm}|}
        \hline
        \rowcolor{tsRed}
        \cellcolor{tsRed}{\fontsize{9pt}{11pt}\selectfont\color{white}\textbf{Dimension}} &
        \cellcolor{tsRed}{\fontsize{9pt}{11pt}\selectfont\color{white}\textbf{Wt}} &
        \cellcolor{tsRed}{\fontsize{9pt}{11pt}\selectfont\color{white}\textbf{Score}} &
        \cellcolor{tsRed}{\fontsize{9pt}{11pt}\selectfont\color{white}\textbf{Status}} \\
        \hline
}{%
    \end{tabular}
    \par
}

% Compact rubric row - smaller font for side-by-side
\newcommand{\rubricRowC}[4]{%
    {\fontsize{9pt}{11pt}\selectfont #1} &
    {\fontsize{9pt}{11pt}\selectfont #2} &
    {\fontsize{9pt}{11pt}\selectfont \textbf{#3}} &
    {\fontsize{9pt}{11pt}\selectfont #4} \\
    \hline
}

% Side-by-side layout: snowflake on left (7cm), compact table on right (10cm)
\newenvironment{tsRubricSplit}[5]{%
    \par\noindent
    \begin{minipage}[c]{7.0cm}
        \centering
        \tsSnowflake{#1}{#2}{#3}{#4}{#5}%
    \end{minipage}%
    \hfill%
    \begin{minipage}[c]{10.0cm}
        \begin{tsRubricTableCompact}
}{%
        \end{tsRubricTableCompact}
    \end{minipage}
    \par
}

% ===== Hanging-indent bullet list (Pattern Diagnosis style) =====
\newenvironment{tspoints}{%
    \begin{list}{\textbullet}{%
        \setlength{\leftmargin}{1.0em}%
        \setlength{\itemindent}{0pt}%
        \setlength{\labelsep}{0.5em}%
        \setlength{\labelwidth}{0.5em}%
        \setlength{\itemsep}{4pt}%
        \setlength{\parsep}{0pt}%
        \setlength{\topsep}{4pt}%
        \setlength{\listparindent}{0pt}%
    }
}{\end{list}}

