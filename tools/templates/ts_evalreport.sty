% ===== SWOT Matrix (2x2 grid) =====
% Usage:
%   \begin{tsSWOT}
%       {<S bullets in tspoints>}
%       {<W bullets in tspoints>}
%       {<O bullets in tspoints>}
%       {<T bullets in tspoints>}
%   \end{tsSWOT}
% Each quadrant takes a list of \item bullets (use \tsSWOTpoint{title}{body})
\newcommand{\tsSWOTbox}[4]{%
    % #1: header label (e.g. "STRENGTHS")
    % #2: header color
    % #3: body content (list of \tsSWOTpoint items)
    % #4: equal-height group key (row-scoped) for dynamic sizing
    \begin{tcolorbox}[
        enhanced,
        colback=white, colframe=#2,
        boxrule=0.6pt, arc=2pt,
        left=8pt, right=8pt, top=4pt, bottom=8pt,
        before skip=0pt, after skip=0pt,
        nobeforeafter,
        equal height group=#4,
        valign=top
    ]
        % Inline header bar (no floating title - keeps everything inside the box bounds)
        \par\noindent
        \begin{tcolorbox}[
            colback=#2, colframe=#2, boxrule=0pt, arc=2pt,
            left=8pt, right=8pt, top=2pt, bottom=2pt,
            halign=center, valign=center,
            before skip=0pt, after skip=0pt,
            width=\linewidth,
            nobeforeafter
        ]
            {\fontsize{9pt}{11pt}\selectfont\color{white}\textbf{#1}}
        \end{tcolorbox}%
        \par\vspace{4pt}%
        \begin{list}{$\bullet$}{%
            \setlength{\leftmargin}{1.0em}%
            \setlength{\itemindent}{0pt}%
            \setlength{\labelwidth}{0.7em}%
            \setlength{\labelsep}{0.3em}%
            \setlength{\listparindent}{0pt}%
            \setlength{\topsep}{0pt}%
            \setlength{\parsep}{0pt}%
            \setlength{\itemsep}{4pt}%
            \fontsize{8.5pt}{11pt}\selectfont\color{tsText}%
        }
        #3
        \end{list}
    \end{tcolorbox}%
}

% Bullet inside a SWOT quadrant
\newcommand{\tsSWOTpoint}[2]{%
    \item \textbf{#1}\ #2%
}

% Full SWOT 2x2 grid - args are the 4 quadrant contents (S, W, O, T)
% Usage:
%   \tsSWOT
%       {\tsSWOTpoint{Title}{body} \tsSWOTpoint{...}{...}}
%       {\tsSWOTpoint{...}{...}}
%       {\tsSWOTpoint{...}{...}}
%       {\tsSWOTpoint{...}{...}}
\newcommand{\tsSWOT}[4]{%
    \par\vspace{0.3cm}\noindent
    % Top row: Strengths (left) + Weaknesses (right) — equal height grows with content
    \begin{minipage}[t]{8.3cm}
        \tsSWOTbox{STRENGTHS}{tsGreen}{#1}{swotrowSW}
    \end{minipage}%
    \hfill%
    \begin{minipage}[t]{8.3cm}
        \tsSWOTbox{WEAKNESSES}{tsRed}{#2}{swotrowSW}
    \end{minipage}
    \par\vspace{0.4cm}\noindent
    % Bottom row: Opportunities (left) + Threats (right) — equal height grows with content
    \begin{minipage}[t]{8.3cm}
        \tsSWOTbox{OPPORTUNITIES}{tsBlue}{#3}{swotrowOT}
    \end{minipage}%
    \hfill%
    \begin{minipage}[t]{8.3cm}
        \tsSWOTbox{THREATS}{tsAmber}{#4}{swotrowOT}
    \end{minipage}
    \par
}

