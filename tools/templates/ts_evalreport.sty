\newcommand{\tsQFuncContent}{}
\newcommand{\tsQAnswerYour}{}
\newcommand{\tsQAnswerIdeal}{}
\newcommand{\tsQDimCU}{0}
\newcommand{\tsQDimAM}{0}
\newcommand{\tsQDimSS}{0}
\newcommand{\tsQDimNA}{0}
\newcommand{\tsQDimPR}{0}
\newcommand{\tsQFeedbackText}{}
\newcommand{\tsQScanNoteText}{}
