% ===== Scanning Tips for Future Submissions =====
% Bordered 5x2 tabular. Each cell shows the tip number in its own 0.55cm
% gutter on the left; the tip text starts after the gutter and wraps with
% a hanging indent so wrapped lines align with the title, NOT under the
% number — matching the May-14 reference layout.
% Inner mini-tabular per cell: 8mm number gutter + 7.4cm text column.
% Text column has its own physical left edge at 8mm, so every wrapped
% line aligns at 8mm — true hanging indentation by table geometry.
% 9pt font on 14pt baseline = 3pt extra interline leading.
\newcommand{\tsScanningTipItem}[2]{%
    \fontsize{9pt}{14pt}\selectfont\color{tsText}%
    \begin{tabular}{@{}p{8mm}@{}>{\raggedright\arraybackslash}p{7.4cm}@{}}
        \textbf{#1.} & #2
    \end{tabular}%
}
% Outer table: total 17cm = 2 x 8.5cm cells (8.2cm p{} + 2 x 1.5mm
% tabcolsep padding = 8.5cm visible). arraystretch 1.4 → ~6pt extra row
% spacing for the paragraph gap.
\newcommand{\tsScanningTips}{%
    \par\vspace{0.2cm}\noindent
    \setlength{\tabcolsep}{1.5mm}%
    \renewcommand{\arraystretch}{1.07}%
    \arrayrulecolor{tsLightGrey}%
    \begin{tabular}{|>{\raggedright\arraybackslash}p{8.2cm}|>{\raggedright\arraybackslash}p{8.2cm}|}
        \hline
        \tsScanningTipItem{1}{Keep fingers and thumbs out of frame. Hold the page from a corner that's outside the camera view, or use a flat surface and weights (books on the corners). Thumbs in the frame block content and make pages look unprofessional.}
        &
        \tsScanningTipItem{6}{Number every question clearly. Write the question number large at the start of each answer (e.g.\ Q7.). If you skip a question and come back to it, mark it — don't leave the evaluator hunting.}
        \\\hline
        \tsScanningTipItem{2}{One page per image. Don't capture two notebook pages in one shot. Each question's working should be readable without zooming. If a question spans two pages, that's fine — just take two clean shots.}
        &
        \tsScanningTipItem{7}{Box your final answer. A clear final-answer box at the end of each question saves the evaluator from reading the entire derivation just to find your conclusion.}
        \\\hline
        \tsScanningTipItem{3}{Even, indirect lighting. Avoid direct sunlight or a single overhead lamp — both create shadows or glare strips. Diffuse light from a window (no direct sun) or a desk lamp aimed at the wall works best.}
        &
        \tsScanningTipItem{8}{Use a scanner app, not raw photos. Apps like Adobe Scan, Microsoft Lens, or CamScanner auto-correct perspective, sharpen text, and compile pages into a single PDF in question order.}
        \\\hline
        \tsScanningTipItem{4}{Page flat, camera straight overhead. A skewed page distorts the math. Use a clipboard or hardback book underneath to flatten the page, and hold the camera parallel to the page (not at an angle).}
        &
        \tsScanningTipItem{9}{Check page order before exporting. After scanning, flip through the PDF once. Make sure pages run Q1 $\rightarrow$ Q2 $\rightarrow \ldots \rightarrow$ last, with no missing pages and no sideways shots.}
        \\\hline
        \tsScanningTipItem{5}{Use a darker pen. Pencil and very light blue ink fade in scans. A regular blue or black ballpoint or gel pen (0.5\,mm or thicker) gives the best contrast.}
        &
        \tsScanningTipItem{10}{Name the file clearly. Format: BatchName\_StudentName\_\linebreak AssignmentCode.pdf. Don't use generic names like ``Scan001.pdf'' — they get lost.}
        \\\hline
    \end{tabular}\par
}

